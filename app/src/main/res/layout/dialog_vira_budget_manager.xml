<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vira_dialog_surface"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/budget_manager_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/budget_manager_subtitle" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="390dp" android:layout_marginTop="16dp" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:id="@+id/budgetCategoriesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <TextView android:id="@+id/budgetManagerCloseButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:background="@drawable/vira_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/close" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
