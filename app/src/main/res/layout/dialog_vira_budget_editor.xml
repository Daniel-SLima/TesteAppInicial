<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/vira_dialog_surface" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/budget_editor_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/budgetEditorCategoryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/vira_chip" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:textColor="@color/brand_secondary" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/budget_editor_subtitle" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/budget_value_label" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
    <EditText android:id="@+id/budgetValueInput" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:hint="@string/value_hint" android:inputType="numberDecimal" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="18sp" />
    <TextView android:id="@+id/budgetRemoveButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/vira_button_danger_outline" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/remove_limit" android:textColor="@color/expense" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/budgetCancelButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/vira_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/cancel" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <TextView android:id="@+id/budgetSaveButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/vira_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/save" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
